<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Embedded in the exe by app.rc.
     asInvoker: the guide never asks for admin rights; reading another
     process of the same user doesn't need them.
     DPI awareness is deliberately not declared yet: it changes the window
     coordinates the overlay tracks, so it comes with the app window
     (part 4), where it can be checked live. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity type="win32" name="AmishGoose.WASD" version="0.1.0.0" processorArchitecture="amd64"/>
  <description>WASD: World Awareness &amp; State Display</description>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
  <!-- Common Controls 6: the app window's buttons and lists in the native
       Windows 10/11 style instead of the classic look. -->
  <dependency>
    <dependentAssembly>
      <assemblyIdentity type="win32" name="Microsoft.Windows.Common-Controls" version="6.0.0.0"
                        processorArchitecture="*" publicKeyToken="6595b64144ccf1df" language="*"/>
    </dependentAssembly>
  </dependency>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
</assembly>
